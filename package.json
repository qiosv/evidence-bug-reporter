{
  "name": "evidence-replay",
  "version": "1.0.0",
  "description": "Screen recording to an evidence-grounded reproducible bug report. Derived from the Interview Copilot / Iview Protect open-source Electron app.",
  "author": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "fixtures": "tsx scripts/generate-recordings.ts",
    "test:merger": "tsx scripts/test-merger.ts",
    "test:credentials": "tsx scripts/test-credentials.ts",
    "scan:secrets": "tsx scripts/scan-frontend-secrets.ts",
    "scan:persistence": "tsx scripts/scan-credential-persistence.ts",
    "validate:pipeline": "tsx scripts/validate-pipeline.ts",
    "validate:errors": "tsx scripts/validate-errors.ts",
    "validate:byok": "tsx scripts/validate-byok.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "playwright": "^1.55.0",
    "prettier": "^3.7.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.2.6"
  }
}
