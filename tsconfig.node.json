{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "dist/server",
    "noEmit": true,
    "composite": true
  },
  "include": [
    "vite.config.ts",
    "server/**/*.ts",
    "scripts/**/*.ts",
    "src/lib/**/*.ts",
    "src/config/**/*.ts",
    "src/shared/**/*.ts",
    "src/metrics/**/*.ts",
    "src/prompts/**/*.ts",
    "src/analysis/**/*.ts",
    "src/ai/**/*.ts",
    "src/transcription/**/*.ts",
    "src/video/**/*.ts"
  ],
  "exclude": ["scripts/validate-frames.ts"]
}
